.page {
  padding-bottom: 40rpx;
}

.toolbar {
  padding: 24rpx;
}

.add-btn {
  margin: 0;
}

.item-list {
  padding-top: 8rpx;
}

.item-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.06);
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
}

.item-code {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

.item-borrower {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #d97706;
}

.item-actions {
  display: flex;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f1f3;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #3b7cff;
  background: #eef4ff;
  border-radius: 12rpx;
}

.action-btn.danger {
  color: #ef4444;
  background: #fee2e2;
}

/* 表单弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 10;
}

.form-modal {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 15%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  z-index: 11;
}

.form-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.form-field {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #5f646b;
  margin-bottom: 12rpx;
}

.form-input {
  background: #f5f6fa;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.form-textarea {
  background: #f5f6fa;
  border-radius: 12rpx;
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.form-btn {
  flex: 1;
}
