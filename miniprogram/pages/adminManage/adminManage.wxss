.page {
  padding-bottom: 40rpx;
}

.intro {
  padding: 24rpx 32rpx;
  font-size: 26rpx;
  color: #9aa0a6;
}

.user-list {
  padding-top: 8rpx;
}

.user-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.06);
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eef4ff;
  color: #3b7cff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-body {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-name {
  font-size: 30rpx;
  color: #1f2329;
}

.toggle-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #3b7cff;
  background: #eef4ff;
  border-radius: 12rpx;
}

.toggle-btn.off {
  color: #ef4444;
  background: #fee2e2;
}
