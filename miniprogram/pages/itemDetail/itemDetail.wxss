.page {
  padding-bottom: 40rpx;
}

.detail-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.06);
}

.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 600;
}

.detail-code {
  margin-top: 16rpx;
  color: #9aa0a6;
  font-size: 26rpx;
}

.detail-org {
  margin-top: 12rpx;
  color: #3b7cff;
  font-size: 26rpx;
}

.detail-desc {
  margin-top: 12rpx;
  color: #5f646b;
  font-size: 26rpx;
}

.detail-meta {
  margin-top: 12rpx;
  color: #b3b8bf;
  font-size: 24rpx;
}

.detail-borrower {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fef3c7;
  border-radius: 16rpx;
}

.borrower-label {
  font-size: 24rpx;
  color: #b45309;
}

.borrower-name {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #92400e;
}

.borrower-time {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #b45309;
}

.detail-btn {
  margin-top: 32rpx;
}

.detail-hint {
  margin-top: 24rpx;
  color: #9aa0a6;
  font-size: 24rpx;
  text-align: center;
}

.admin-actions {
  display: flex;
  margin-top: 32rpx;
  gap: 20rpx;
}

.admin-btn {
  flex: 1;
}

.btn-danger {
  background: #ffffff;
  color: #ef4444;
  border: 2rpx solid #ef4444;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 84rpx;
  height: 88rpx;
  text-align: center;
}

.btn-danger::after {
  border: none;
}

.records-header {
  margin: 32rpx 32rpx 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.record-item {
  display: flex;
  align-items: flex-start;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 0 24rpx 12rpx;
}

.record-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin: 10rpx 20rpx 0 6rpx;
  flex-shrink: 0;
}

.record-dot.borrow {
  background: #f59e0b;
}

.record-dot.return {
  background: #16a34a;
}

.record-body {
  flex: 1;
}

.record-line {
  font-size: 28rpx;
  color: #1f2329;
}

.record-time {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

.load-more {
  text-align: center;
  padding: 24rpx;
  color: #3b7cff;
  font-size: 26rpx;
}
