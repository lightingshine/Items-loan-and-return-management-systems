.page {
  padding-bottom: 40rpx;
}

.profile {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #4b8bff, #3b7cff);
  color: #ffffff;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #ffffff;
  margin-right: 24rpx;
}

.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #3b7cff;
  font-weight: 600;
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.section {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.06);
}

.section-title {
  padding: 20rpx 0 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #5f646b;
}

.section-empty {
  padding: 32rpx 0;
  color: #9aa0a6;
  font-size: 26rpx;
  text-align: center;
}

.my-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f1f3;
}

.my-item:last-child {
  border-bottom: none;
}

.my-item-name {
  font-size: 30rpx;
  color: #1f2329;
}

.my-item-time {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f0f1f3;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #1f2329;
}

.menu-arrow {
  color: #c0c4ca;
  font-size: 40rpx;
}
